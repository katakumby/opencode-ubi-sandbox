# OpenAI-compatible vLLM endpoints. Include the /v1 suffix.
VLLM_CODE_BASE_URL=https://your-vllm-code.example.com/v1
VLLM_VISION_BASE_URL=https://your-vllm-vision.example.com/v1

# vLLM API key. OpenCode sends this as a bearer token through the AI SDK provider.
VLLM_API_KEY=replace-with-your-vllm-api-key

# Extra identity headers sent to your LLM API.
OPENCODE_HEADER_USER=alice
OPENCODE_HEADER_DOMAIN=engineering

# Enable this when OpenCode/Bun must pass through a corporate DLP proxy that
# negotiates HTTP/2 with the upstream vLLM endpoint.
# OpenCode talks to a loopback HTTP endpoint, and the helper forwards to
# VLLM_CODE_BASE_URL over HTTPS through HTTP_PROXY/HTTPS_PROXY.
# OPENCODE_VLLM_PROXY_ENABLED=true
# OPENCODE_VLLM_PROXY_ADDR=127.0.0.1:11434

# Optional corporate proxy settings.
# Put the proxy in HTTP_PROXY and HTTPS_PROXY explicitly. Some runtimes ignore
# ALL_PROXY for HTTPS requests.
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# ALL_PROXY=http://proxy.example.com:8080
#
# If your DLP proxy is configured in Docker Desktop as localhost, keep that
# corporate value here. The entrypoint rewrites loopback proxy hosts to
# host.docker.internal inside the container, so traffic still uses the host DLP
# proxy instead of container loopback.
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
# ALL_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Optional on Linux: match files created in mounted workspaces to your host user.
# LOCAL_UID=1000
# LOCAL_GID=1000
